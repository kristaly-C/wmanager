# Másold ezt a fájlt a Proxmox szerveren a /opt/wmanager/.env helyre, és írd át az értékeket!

POSTGRES_USER=wmanager
POSTGRES_PASSWORD=cserelj_le_egy_eros_jelszora
POSTGRES_DB=wmanager

# Generálhatsz egyet pl. ezzel: openssl rand -hex 32
JWT_SECRET=cserelj_le_egy_hosszu_titkos_kulcsra

# Első indításkor (üres adatbázisnál) automatikusan létrejövő BOSS fiók adatai:
ADMIN_EMAIL=admin@wmanager.local
ADMIN_PASSWORD=cserelj_le_admin_jelszora
ADMIN_NAME=Admin

# Melyik porton legyen elérhető a webalkalmazás a Proxmox konténer/VM IP címén
APP_PORT=80
