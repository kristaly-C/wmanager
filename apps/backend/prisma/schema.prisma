// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}


enum LocationType {
  WAREHOUSE
  STORE
  ZONE
  SHELF
  BIN
}
enum SlotMode {
  DEDICATED
  MIXED
}
enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  CONFIRMED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}
enum GoodsReceiptStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_APPROVAL
  COMPLETED
  CANCELLED
}
enum StockTransferStatus {
  PENDING
  IN_TRANSIT
  COMPLETED
  CANCELLED
}
enum StocktakeStatus {
  IN_PROGRESS
  WAITING_FOR_APPROVAL
  COMPLETED
  CANCELLED
}
enum Role {
  ADMIN
  STORE_MANAGER
  WAREHOUSE_MANAGER
  WAREHOUSE_STAFF
  STORE_STAFF
  ORDER_CLERK
  RMA_CLERK
  BOSS
}
enum ReturnCaseStatus {
  CREATED
  IN_PROGRESS
  APPROVED
  DECLINED
}
enum SalesOrderStatus {
  ON_HOLD
  PENDING
  PICKING
  READY
  COMPLETED
  CANCELLED
}

enum SalesChannel {
  WEBSHOP
  STORE
  PHONE
  B2B
}

enum PickTaskStatus {
  OPEN
  IN_PROGRESS
  AWAITING_DROP
  COMPLETED
  CANCELLED
}

enum MovementType {
  INITIAL_STOCK
  PURCHASE_RECEIPT
  SALE
  TRANSFER_IN
  TRANSFER_OUT
  STOCKTAKE_ADJUSTMENT
  RETURN_RESTOCK
  MANUAL_CORRECTION
}

enum StockReportStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id    String @id @default(uuid())
  email String @unique
  name  String
  role  Role
  passwordHash String

  qrToken     String? @unique
  stocktakeSessions StocktakeSession[] @relation("StocktakePerformedBy")
  approvedStocktakeSessions StocktakeSession[] @relation("StocktakeApprovedBy")
  returnCases ReturnCase[]
  stockMovements StockMovement[]
  userLocations UserLocation[]
  reportedStockReports StockReport[] @relation("StockReportCreatedBy")
  resolvedStockReports StockReport[] @relation("StockReportResolvedBy")
  createdPurchaseOrders PurchaseOrder[] @relation("PurchaseOrderCreatedBy")
  createdGoodsReceipts GoodsReceipt[] @relation("GoodsReceiptCreatedBy")
  approvedGoodsReceipts GoodsReceipt[] @relation("GoodsReceiptApprovedBy")
  createdSalesOrders SalesOrder[] @relation("SalesOrderCreatedBy")
  completedSalesOrders SalesOrder[] @relation("SalesOrderCompletedBy")
  assignedPickTasks PickTask[] @relation("PickTaskAssignedTo")

  passwordChangedAt DateTime?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id String @id @default(uuid())
  name String
  parentId String?
  parent Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryHierarchy")

  products Product[]
  isActive Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model Product {
   id String @id @default(uuid())
   name String
   gender String?
   usageArea String?
   material String?
   model String?
   manufacturerCode String?
   functionality String?
   variants Variant[]
   vatRate Decimal @db.Decimal(5, 2)
   description String?

   unit String @default("DB")
   vtszCode String?
   originCountry String?
   importantNote String?
   season String?
   isSerialized Boolean @default(false)
   isPurchasable Boolean @default(true)

   primarySupplierId String
   primarySupplier Supplier @relation(fields: [primarySupplierId], references: [id])
   imageUrls String[]

   attributes Json?

   brandId String
   brand Brand @relation(fields: [brandId], references: [id])

   categoryId String
   category Category @relation(fields: [categoryId], references: [id])

   monthlyStats VariantMonthlyStat[]

   isActive Boolean @default(true)
   createdAt DateTime @default(now())
   updatedAt DateTime @updatedAt 

   @@index([categoryId])
   @@index([brandId])
   @@index([primarySupplierId])
   @@index([name])
   @@index([manufacturerCode])
}


model Supplier {
  id String @id @default(uuid())
  name String
  description String?
  phone String?
  email String?
  products Product[]

  purchaseOrders PurchaseOrder[]
  variantSuppliers VariantSupplier[]
  goodsReceipts GoodsReceipt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt 
}

model Variant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])

  sku       String   @unique
  colors    String[] @default([])
  size      String?
  weight    Decimal? @db.Decimal(10, 3)
  netWeight Decimal? @db.Decimal(10, 3)
  volume    Decimal? @db.Decimal(10, 6)
  imageUrls String[] @default([])
  
  stocktakeItems StocktakeItem[]
  stockItems  StockItem[]
  returnCaseItems ReturnCaseItem[]
  stockMovements StockMovement[]
  variantBarcodes VariantBarcode[]
  stockReports StockReport[]
  variantSuppliers VariantSupplier[]
  purchaseOrderItems PurchaseOrderItem[]
  goodsReceiptItems GoodsReceiptItem[]
  monthlyStats VariantMonthlyStat[]
  salesOrderItems SalesOrderItem[]
  pickTaskItems PickTaskItem[]

  netPrice          Decimal   @db.Decimal(12, 2)
  grossPrice        Decimal   @db.Decimal(12, 2)
  costPrice         Decimal   @db.Decimal(12, 2)
  costCurrency      String    @default("HUF")
  lastPurchasePrice Decimal?  @db.Decimal(12, 2)
  lastPurchaseAt    DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model Location {
  id          String  @id @default(uuid())
  parentId    String?
  parent      Location? @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Location[] @relation("LocationHierarchy")
  
  name        String
  description String?
  type        LocationType
  
  stockItems  StockItem[]
  stockMovements StockMovement[]
  transfersFrom StockTransfer[] @relation("TransferFrom")
  transfersTo   StockTransfer[] @relation("TransferTo")
  stocktakeSessions StocktakeSession[]

  userLocations UserLocation[]
  stockReports StockReport[]
  goodsReceipts GoodsReceipt[] @relation("GoodsReceiptTargetLocation")
  goodsReceiptItemsExpected GoodsReceiptItem[] @relation("GoodsReceiptItemExpectedLocation")
  salesOrdersAsSource SalesOrder[] @relation("SalesOrderSourceLocation")
  salesOrdersTransferFrom SalesOrder[] @relation("SalesOrderTransferFrom")
  pickTasksAsSource PickTask[] @relation("PickTaskSourceLocation")
  pickTasksAsZone PickTask[] @relation("PickTaskZone")
  pickTasksAsDropoff PickTask[] @relation("PickTaskDropoffLocation")
  pickTaskItemsSuggested PickTaskItem[] @relation("PickTaskItemSuggestedLocation")

  isActive            Boolean @default(true)
  slotMode            SlotMode?
  canFulfillWebshop   Boolean @default(true)
  fulfillmentPriority Int     @default(100)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
}

model StockItem {
  id          String @id @default(uuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  variantId   String
  variant     Variant @relation(fields: [variantId], references: [id])
  
  quantity    Int       @default(0)
  reservedQuantity  Int @default(0)

  minStockLevel Int?
  maxStockLevel Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, locationId])
  @@index([locationId])
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  orderNumber          String              @unique
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])

  status               PurchaseOrderStatus @default(DRAFT)
  currency             String              @default("HUF")
  exchangeRate         Decimal             @default(1) @db.Decimal(12, 4)
  supplierReference    String?
  orderedAt            DateTime?
  confirmedAt          DateTime?
  expectedDeliveryDate DateTime?
  note                 String?

  createdByUserId      String?
  createdByUser        User?               @relation("PurchaseOrderCreatedBy", fields: [createdByUserId], references: [id])

  items                PurchaseOrderItem[]
  goodsReceipts        GoodsReceipt[]
  stockMovements       StockMovement[]

  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([supplierId])
  @@index([status])
}


model StockTransfer {
  id             String   @id @default(uuid())

  fromLocationId String
  fromLocation   Location @relation("TransferFrom", fields: [fromLocationId], references: [id])

  toLocationId   String
  toLocation     Location @relation("TransferTo", fields: [toLocationId], references: [id])

  status         StockTransferStatus
  stockMovements StockMovement[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([fromLocationId])
  @@index([toLocationId])
}

model StocktakeSession {
  id          String            @id         @default(uuid())
  locationId  String
  location    Location          @relation(fields: [locationId], references: [id])
  status      StocktakeStatus   @default(IN_PROGRESS)
  note        String?

  startedAt     DateTime        @default(now())
  completedAt   DateTime?
  
  performedByUserId   String?
  performedBy         User?      @relation("StocktakePerformedBy", fields: [performedByUserId], references: [id])
  
  approvedByUserId String?
  approvedBy User?              @relation("StocktakeApprovedBy", fields: [approvedByUserId], references: [id])
  
  items             StocktakeItem[]
  stockMovements    StockMovement[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([locationId])
  @@index([performedByUserId])
}
model StocktakeItem {
  id          String        @id @default(uuid())
  stocktakeSessionId  String
  stocktakeSession  StocktakeSession  @relation(fields: [stocktakeSessionId], references: [id], onDelete: Cascade)

  variantId   String
  variant     Variant     @relation(fields: [variantId], references: [id])

  expectedQuantity  Int
  countedQuantity   Int?
  discrepancy    Int?
  note              String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([stocktakeSessionId, variantId])
  @@index([stocktakeSessionId])
  @@index([variantId])
}

model ReturnCase {
  id        String @id @default(uuid())

  handledByUserId String
  handledByUser   User @relation(fields: [handledByUserId], references: [id])

  items ReturnCaseItem[]
  stockMovements StockMovement[]
  status       ReturnCaseStatus @default(CREATED)
  returnReason String
  resultNote   String?

  customerName   String?
  customerEmail  String?
  customerPhone  String?
  orderReference String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([handledByUserId])
}

model ReturnCaseItem {
  id           String @id @default(uuid())

  returnCaseId String
  returnCase   ReturnCase @relation(fields: [returnCaseId], references: [id], onDelete: Cascade)

  variantId    String
  variant      Variant @relation(fields: [variantId], references: [id])

  quantity     Int

  createdAt    DateTime @default(now())

  @@index([returnCaseId])
  @@index([variantId])
}

model SalesOrder {
  id                              String           @id @default(uuid())
  orderNumber                     String           @unique
  externalOrderRef                String?
  channel                         SalesChannel     @default(WEBSHOP)
  isPickup                        Boolean          @default(false)
  status                          SalesOrderStatus @default(PENDING)
  sourceLocationId                String
  sourceLocation                  Location         @relation("SalesOrderSourceLocation", fields: [sourceLocationId], references: [id])
  transferRequestedFromLocationId String?
  transferRequestedFromLocation   Location?        @relation("SalesOrderTransferFrom", fields: [transferRequestedFromLocationId], references: [id])
  holdReason                      String?
  customerName                    String
  customerEmail                   String?
  customerPhone                   String?
  shippingAddress                 String?
  note                            String?
  createdByUserId                 String?
  createdByUser                   User?            @relation("SalesOrderCreatedBy", fields: [createdByUserId], references: [id])
  completedByUserId               String?
  completedByUser                 User?            @relation("SalesOrderCompletedBy", fields: [completedByUserId], references: [id])
  completedAt                     DateTime?
  cancelledAt                     DateTime?

  items          SalesOrderItem[]
  pickTasks      PickTask[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sourceLocationId, status])
  @@index([status, createdAt])
  @@index([externalOrderRef])
}

model SalesOrderItem {
  id               String         @id @default(uuid())
  salesOrderId     String
  salesOrder       SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  variantId        String
  variant          Variant        @relation(fields: [variantId], references: [id])
  orderedQuantity  Int
  reservedQuantity Int            @default(0)
  pickedQuantity   Int            @default(0)
  unitNetPrice     Decimal        @db.Decimal(12, 2)
  unitGrossPrice   Decimal        @db.Decimal(12, 2)
  vatRate          Decimal        @db.Decimal(5, 2)
  discountPercent  Decimal?       @db.Decimal(5, 2)
  note             String?
  pickTaskItems    PickTaskItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([salesOrderId, variantId])
  @@index([variantId])
}

model PickTask {
  id                String         @id @default(uuid())
  taskNumber        String         @unique
  salesOrderId      String
  salesOrder        SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  sourceLocationId  String
  sourceLocation    Location       @relation("PickTaskSourceLocation", fields: [sourceLocationId], references: [id])
  zoneId            String?
  zone              Location?      @relation("PickTaskZone", fields: [zoneId], references: [id])
  status            PickTaskStatus @default(OPEN)
  assignedToUserId  String?
  assignedToUser    User?          @relation("PickTaskAssignedTo", fields: [assignedToUserId], references: [id])
  toteCode          String?
  dropoffLocationId String?
  dropoffLocation   Location?      @relation("PickTaskDropoffLocation", fields: [dropoffLocationId], references: [id])
  dropoffCode       String?
  startedAt         DateTime?
  droppedAt         DateTime?
  completedAt       DateTime?

  items          PickTaskItem[]
  stockMovements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([salesOrderId])
  @@index([sourceLocationId, status])
  @@index([zoneId, status])
  @@index([assignedToUserId, status])
}

model PickTaskItem {
  id                  String         @id @default(uuid())
  pickTaskId          String
  pickTask            PickTask       @relation(fields: [pickTaskId], references: [id], onDelete: Cascade)
  salesOrderItemId    String
  salesOrderItem      SalesOrderItem @relation(fields: [salesOrderItemId], references: [id], onDelete: Cascade)
  variantId           String
  variant             Variant        @relation(fields: [variantId], references: [id])
  suggestedLocationId String?
  suggestedLocation   Location?      @relation("PickTaskItemSuggestedLocation", fields: [suggestedLocationId], references: [id])
  requiredQuantity    Int
  pickedQuantity      Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([pickTaskId, salesOrderItemId])
  @@index([variantId])
  @@index([salesOrderItemId])
}

model StockMovement {
  id                  String  @id @default(uuid())

  purchaseOrderId     String?
  purchaseOrder       PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  goodsReceiptId      String?
  goodsReceipt        GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])
  salesOrderId        String?
  salesOrder          SalesOrder? @relation(fields: [salesOrderId],references: [id])
  pickTaskId          String?
  pickTask            PickTask? @relation(fields: [pickTaskId], references: [id])
  stocktakeSessionId  String?
  stocktakeSession    StocktakeSession? @relation(fields: [stocktakeSessionId], references: [id])
  stockTransferId     String?
  stockTransfer       StockTransfer? @relation(fields: [stockTransferId], references: [id])
  returnCaseId        String?
  returnCase          ReturnCase? @relation(fields: [returnCaseId], references: [id])

  type                MovementType
  variantId           String
  variant             Variant @relation(fields: [variantId], references: [id])
  locationId          String
  location            Location @relation(fields: [locationId], references: [id])
  quantity            Int
  unitCostHuf         Decimal? @db.Decimal(12, 2)
  unitPriceHuf        Decimal? @db.Decimal(12, 2)
  reversedMovementId  String?  @unique
  reversedMovement    StockMovement? @relation("StockMovementReversal", fields: [reversedMovementId], references: [id], onDelete: Restrict)
  reversedBy          StockMovement? @relation("StockMovementReversal")
  note                String?
  
  createdByUserId     String
  createdByUser       User  @relation(fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([locationId, createdAt])
  @@index([variantId, createdAt])
  @@index([variantId, type, createdAt])
  @@index([goodsReceiptId])
  @@index([pickTaskId])
  @@index([createdByUserId])
}

model VariantBarcode {
  id        String @id @default(uuid())
  variantId String
  variant   Variant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  barcode   String @unique
  isPrimary Boolean @default(false)
  note      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([variantId])
}

model Brand {
  id    String  @id @default(uuid())
  name  String  @unique
  description String?

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserLocation {
  id String @id @default(uuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  locationId String
  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@unique([userId, locationId])
  @@index([locationId])
}

model SystemSetting {
  key       String   @id
  boolValue Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model StockReport {
  id               String            @id @default(uuid())
  variantId        String
  variant          Variant           @relation(fields: [variantId], references: [id])
  locationId       String
  location         Location          @relation(fields: [locationId], references: [id])
  expectedQuantity Int
  foundQuantity    Int
  reason           String
  status           StockReportStatus @default(PENDING)
  reportedByUserId String
  reportedByUser   User              @relation("StockReportCreatedBy", fields: [reportedByUserId], references: [id])
  resolvedByUserId String?
  resolvedByUser   User?             @relation("StockReportResolvedBy", fields: [resolvedByUserId], references: [id])
  resolutionNote   String?
  resolvedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([locationId, status])
  @@index([variantId])
  @@index([reportedByUserId])
}

model VariantSupplier {
  id                  String   @id @default(uuid())
  variantId           String
  variant             Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  supplierId          String
  supplier            Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  supplierSku         String?
  supplierProductName String?
  purchasePrice       Decimal  @db.Decimal(12, 2)
  currency            String   @default("HUF")
  discountPercent     Decimal? @db.Decimal(5, 2)
  orderUnit           String?
  isPrimary           Boolean  @default(false)
  note                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([variantId, supplierId])
  @@index([supplierId])
  @@index([variantId])
}

model PurchaseOrderItem {
  id                String             @id @default(uuid())
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variantId         String
  variant           Variant            @relation(fields: [variantId], references: [id])
  orderedQuantity   Int
  confirmedQuantity Int?
  receivedQuantity  Int                @default(0)
  unitCost          Decimal            @db.Decimal(12, 2)
  note              String?
  goodsReceiptItems GoodsReceiptItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([purchaseOrderId, variantId])
  @@index([variantId])
}

model GoodsReceipt {
  id               String             @id @default(uuid())
  receiptNumber    String             @unique
  purchaseOrderId  String?
  purchaseOrder    PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  supplierId       String?
  supplier         Supplier?          @relation(fields: [supplierId], references: [id])
  targetLocationId String
  targetLocation   Location           @relation("GoodsReceiptTargetLocation", fields: [targetLocationId], references: [id])
  invoiceNumber    String?
  currency         String             @default("HUF")
  exchangeRate     Decimal            @default(1) @db.Decimal(12, 4)
  status           GoodsReceiptStatus @default(OPEN)
  discrepancyNote  String?
  note             String?
  createdByUserId  String
  createdByUser    User               @relation("GoodsReceiptCreatedBy", fields: [createdByUserId], references: [id])
  approvedByUserId String?
  approvedByUser   User?              @relation("GoodsReceiptApprovedBy", fields: [approvedByUserId], references: [id])
  approvedAt       DateTime?
  completedAt      DateTime?
  items            GoodsReceiptItem[]
  stockMovements   StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseOrderId])
  @@index([supplierId])
  @@index([targetLocationId, status])
  @@index([status])
}

model GoodsReceiptItem {
  id                  String             @id @default(uuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  variantId           String
  variant             Variant            @relation(fields: [variantId], references: [id])
  expectedQuantity    Int
  receivedQuantity    Int                @default(0)
  unitCost            Decimal            @db.Decimal(12, 2)
  unitCostHuf         Decimal            @db.Decimal(12, 2)
  expectedLocationId  String?
  expectedLocation    Location?          @relation("GoodsReceiptItemExpectedLocation", fields: [expectedLocationId], references: [id])
  isUnexpected        Boolean            @default(false)
  note                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([goodsReceiptId, variantId])
  @@index([variantId])
  @@index([purchaseOrderItemId])
}

model VariantMonthlyStat {
  id                    String   @id @default(uuid())
  variantId             String
  variant               Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  productId             String
  product               Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  year                  Int
  month                 Int
  purchasedQty          Int      @default(0)
  purchasedTotalCostHuf Decimal  @default(0) @db.Decimal(14, 2)
  soldQty               Int      @default(0)
  soldRevenueHuf        Decimal  @default(0) @db.Decimal(14, 2)
  soldCogsHuf           Decimal  @default(0) @db.Decimal(14, 2)
  returnedQty           Int      @default(0)
  adjustmentQty         Int      @default(0)
  updatedAt             DateTime @updatedAt

  @@unique([variantId, year, month])
  @@index([productId, year, month])
  @@index([year, month])
}